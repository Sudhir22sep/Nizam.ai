# MongoDB Configuration
# PRODUCTION: Uses ammawears_prod database (set NODE_ENV=production)
# DEVELOPMENT: Uses ammawears_dev database (set NODE_ENV=development or omit)
# The server auto-selects database based on NODE_ENV

# For Production (Render/Vercel):
# MONGODB_URI=your_mongodb_uri
# NODE_ENV=production

# For Development (Codespaces/Local) - uncomment and use test keys:
MONGODB_URI=your_mongodb_uri
#/ammawears_dev?retryWrites=true&w=majority
NODE_ENV=development

# For Integration (testing/staging):
# MONGODB_URI=mongodb+srv://sudhir22sep_db_user:Sudhir0501@amma-wear.vgvwvpo.mongodb.net/ammawears_int?retryWrites=true&w=majority
# NODE_ENV=integration


# For Local MongoDB (optional):
# MONGODB_URI=mongodb://localhost:27017/ammawears_local

# Razorpay Configuration
# Use LIVE keys for production (RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET)
# Use TEST keys for development (RAZORPAY_TEST_KEY_ID, RAZORPAY_TEST_KEY_SECRET)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_TEST_KEY_ID=your_razorpay_test_key_id
RAZORPAY_TEST_KEY_SECRET=your_razorpay_test_key_secret

# Google Gemini / AI Studio Configuration (free tier, optional)
# Create a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key

# AWS SES Configuration (required to actually SEND email; messages are still
# recorded in MongoDB when SES is not configured)
SES_REGION=eu-north-1
# Must be a verified identity in SES. In the SES sandbox every recipient must
# also be verified, otherwise sending fails.
SES_VERIFIED_SENDER=ammacollectivewear@gmail.com
# Static IAM credentials with ses:SendEmail / ses:SendRawEmail.
# Leave these commented out to use the AWS SDK default credential chain
# (environment, AWS_PROFILE / SSO, instance role).
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Application URL
APP_URL=https://ammawears.com

# Server Port
PORT=4000

# JWT Secret - required for authentication
JWT_SECRET=your_256_bit_secret_key_here

# Meta / WhatsApp Cloud API webhook
# META_VERIFY_TOKEN is the string you type into the Meta app dashboard when
# subscribing the callback URL; any value works as long as both sides match.
# META_VERIFY_TOKEN=ammawearssecret2026
# META_APP_SECRET is the app secret used to verify the X-Hub-Signature-256 header
# on inbound deliveries. While it is unset every POST is rejected with 401.
# META_APP_SECRET=your_meta_app_secret
