/**
 * Standalone type-check config for the Express/Angular SSR server entry.
 *
 * `ng build` compiles `src/server.ts` through `tsconfig.app.json`; this config
 * exists so the server can also be checked on its own with
 * `tsc -p tsconfig.server.json`. It includes the whole `src` tree because
 * `src/middleware/auth.ts` augments Express' `Request` with `user`.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/server",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts"
  ]
}