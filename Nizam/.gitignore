# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.
node_modules/

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# Generated responsive image variants (see scripts/optimize-images.mjs).
# Rebuilt with `npm run optimize:images`, so they do not belong in the repo.
/public/images/products/*.webp

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db
# Environment Variables
.env
.env.example

# Capacitor / Ionic mobile app
#
# /www is the Angular mobile build output that `cap copy` feeds into
# android/ and ios/ — regenerated by `npm run build:mobile`, so it is not
# source.
/www

# Android build products. The rest of android/ IS committed: Capacitor needs
# the project checked in for reproducible builds and CI.
android/.gradle
android/build
android/app/build
android/local.properties
android/.idea
android/captures
android/*.iml
android/app/release
*.jks
*.keystore

# iOS build products (Xcode/CocoaPods output). The rest of ios/ is committed
# for the same reason as android/.
ios/App/Pods
ios/App/App/public
ios/App/App/build
ios/App/App/App.xcworkspace/xcuserdata
ios/App/App/Pods
ios/DerivedData
ios/build
ios/App/App.xcarchive
*.mobileprovision
*.p12

# Generated icon/splash sources. Derived from the brand logo by
# `npm run assets:source`; the generated native assets live in android/ios and
# ARE committed.
/resources/icon.png
/resources/splash.png
