{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [],
    "lib": ["ES2020", "dom"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "bundler",
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.ts",
    "src/index.html"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/server.ts",
    "src/main.server.ts",
    "src/test-setup.ts"
  ]
}