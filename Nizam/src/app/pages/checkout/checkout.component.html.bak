<div class="checkout-page">
  <h1>Checkout</h1>

  <div *ngIf="orderConfirmed" class="order-confirmation">
    <h2>Thank you for your purchase!</h2>
    <p>Your order reference is <strong>{{ confirmationReference }}</strong>.</p>
    <p>We’ll send shipping updates to <strong>{{ email }}</strong>.</p>
    <a routerLink="/products" class="btn-primary">Continue shopping</a>
  </div>

  <div *ngIf="!orderConfirmed">
    <div class="checkout-layout">
      <section class="cart-summary">
        <h2>Order summary</h2>
        <div *ngIf="items.length > 0; else emptyCart">
          <div *ngFor="let item of items" class="cart-item">
            <div>
              <h3>{{ item.product.name }}</h3>
              <p>{{ item.quantity }} × {{ item.product.price | price }}</p>
            </div>
            <div class="item-total">
              {{ item.product.price * item.quantity | price }}
            </div>
          </div>

          <div class="cart-total">
            <span>Total</span>
            <strong>{{ totalAmount | price }}</strong>
          </div>
        </div>

        <ng-template #emptyCart>
          <p>Your cart is empty. Add a product and return to checkout.</p>
          <a routerLink="/products" class="btn-secondary">Go to shop</a>
        </ng-template>
      </section>

      <section class="payment-form" *ngIf="items.length > 0">
        <h2>Payment & shipping</h2>

        <form (ngSubmit)="submitOrder()">
          <label>
            Full name
            <input type="text" [(ngModel)]="name" name="name" required />
          </label>

          <label>
            Email address
            <input type="email" [(ngModel)]="email" name="email" required />
          </label>

          <label>
            Shipping address
            <textarea [(ngModel)]="address" name="address" rows="3" required></textarea>
          </label>

          <fieldset class="payment-methods">
            <legend>Payment method</legend>
            <label>
              <input type="radio" name="paymentMethod" value="stripe" [(ngModel)]="paymentMethod" />
              Stripe Checkout
            </label>
            <label>
              <input type="radio" name="paymentMethod" value="razorpay" [(ngModel)]="paymentMethod" />
              Razorpay
            </label>
            <label>
              <input type="radio" name="paymentMethod" value="cod" [(ngModel)]="paymentMethod" />
              Cash on delivery (COD)
            </label>
          </fieldset>

          <div *ngIf="paymentMethod === 'stripe'" class="payment-note">
            <p>You will enter your card details on Stripe's secure checkout page.</p>
          </div>

          <div *ngIf="paymentMethod === 'razorpay'" class="payment-note">
            <p>You will enter your card details in Razorpay's secure popup.</p>
          </div>

          <button type="submit" class="btn-primary">
            {{ paymentMethod === 'cod' ? 'Place order with COD' : 'Submit payment' }}
          </button>
        </form>

        <p class="hint">
          For dropshipping or wholesale inquiries, please email <strong>sudhir.22sep@gmail.com</strong>.
        </p>
      </section>
    </div>
  </div>
</div>
