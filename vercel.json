{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd Nizam && npm ci",
  "buildCommand": "cd Nizam && npm run build",
  "outputDirectory": "Nizam/dist/Nizam/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "build": {
    "env": {
      "NODE_OPTIONS": "--max_old_space_size=4096"
    }
  }
}
