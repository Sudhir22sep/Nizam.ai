+import { Injectable } from '@angular/core';
+import { HttpClient } from '@angular/common/http';
+import { AuthService } from './auth.service';
+
+@Injectable({
+  providedIn: 'root'
+})
+export class WishlistService {
+  private apiUrl = '/api';
+
+  constructor(private http: HttpClient, private authService: AuthService) { }
+
+  private getAuthHeaders() {
+    const token = this.authService.getToken();
+    return token ? { Authorization: `Bearer ${token}` } : {};
+  }
+
+  getWishlists(userId: string) {
+    return this.http.get(`${this.apiUrl}/wishlist`, { 
+      params: { userId },
+      headers: this.getAuthHeaders()
+    });
+  }
+
+  createWishlist(name: string) {
+    return this.http.post(`${this.apiUrl}/wishlist`, { name }, { 
+      headers: this.getAuthHeaders() 
+    });
+  }
+
+  getWishlist(id: string) {
+    return this.http.get(`${this.apiUrl}/wishlist/${id}`, { 
+      headers: this.getAuthHeaders() 
+    });
+  }
+
+  addItemToWishlist(wishlistId: string, productId: string) {
+    return this.http.post(`${this.apiUrl}/wishlist/${wishlistId}/items`, { productId }, { 
+      headers: this.getAuthHeaders() 
+    });
+  }
+
+  removeItemFromWishlist(wishlistId: string, itemId: string) {
+    return this.http.delete(`${this.apiUrl}/wishlist/${wishlistId}/items/${itemId}`, { 
+      headers: this.getAuthHeaders() 
+    });
+  }
+}
